# Copy this file to .env and fill in real values. Never commit the real .env.

# MongoDB
DATABASE_URL=mongodb://localhost:27017
DATABASE_NAME=kabadiwala_connect

# JWT
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_BEFORE_DEPLOYMENT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Demo admin seed (Section 29 of the architecture doc — DEMO ONLY, override in production)
ADMIN_DEFAULT_USERNAME=REPLACE_BEFORE_DEPLOYMENT
ADMIN_DEFAULT_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_BEFORE_DEPLOYMENT

# API
API_BASE_URL=http://localhost:8000

# CORS — regex of browser origins allowed to call this API cross-origin
# (Flutter web build, and later the RRR/Recycler/Admin websites). Default
# is loopback-only (any port), for local dev/demo. Override per real
# deployed frontend origin in production — never widen to allow everything.
CORS_ALLOWED_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

# Geo verification (used from Phase 2 onward, declared here for consistency)
MAX_HANDOVER_DISTANCE_METERS=150
MAX_HANDOVER_WINDOW_HOURS=48

# AI classification (Phase 8). Phase 8 ships only a deterministic, local,
# offline mock classifier behind the swappable ClassifierService interface
# (no real image storage exists yet to send anywhere) — AI_PROVIDER_API_KEY
# below is reserved for a future real-provider integration and is read by
# no code path yet. Leave it unset; classification works identically
# either way, which is how "must work without AI credentials" is proven.
# Never commit a real value here even once a provider exists.
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.6
AI_MODEL_VERSION=ewaste-classifier-v1
AI_PROVIDER_API_KEY=

# Payments (Phase 9). Mock gateway only — no real provider integration
# exists, and no payment credential of any kind is ever read from here.
PAYMENT_MODE=MOCK_PAYMENT_GATEWAY

# Rewards (Phase 9). No item weight is ever recorded anywhere in this
# system, so the formula is points-per-item, not points-per-kg.
REWARD_POINTS_PER_ITEM=10
REWARD_VALUE_PER_POINT_INR=0.50

# Lots / bidding window (used from Phase 5 onward)
LOT_BID_WINDOW_DAYS=7

# Bidding (used from Phase 6 onward)
BID_ACCEPTANCE_CANCEL_WINDOW_HOURS=24
